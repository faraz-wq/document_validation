{
  "openapi": "3.0.0",
  "info": {
    "title": "Document Validation Service API",
    "description": "API for document validation and extraction services with user authentication and session management",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "Main server"
    }
  ],
  "paths": {
    "/v1/me/sessions/": {
      "get": {
        "tags": [
          "v1-sessions",
          "user-session"
        ],
        "summary": "List user sessions",
        "description": "Returns a list of sessions owned by the currently authenticated user, with pagination support",
        "operationId": "list_user_sessions",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of sessions to return per page (1-100)",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Number of sessions to skip before starting to collect the result set",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with user session list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserSessionListResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid or missing JWT token"
          },
          "422": {
            "description": "Validation error - invalid parameters"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/v1/me/sessions/{session_id}": {
      "get": {
        "tags": [
          "v1-sessions",
          "user-session"
        ],
        "summary": "Get user session details",
        "description": "Returns detailed information about a specific session owned by the currently authenticated user",
        "operationId": "get_user_session",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "description": "Unique identifier of the session to retrieve",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with session details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionDetailResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid or missing JWT token"
          },
          "404": {
            "description": "Session not found or not owned by the user"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/v1/me/api-keys/": {
      "get": {
        "tags": [
          "v1-me-api-keys",
          "authentication"
        ],
        "summary": "List user API keys",
        "description": "Returns a list of API keys owned by the currently authenticated user",
        "operationId": "list_user_api_keys_endpoint",
        "responses": {
          "200": {
            "description": "Successful response with user API key list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiKeyListResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid or missing JWT token"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      },
      "post": {
        "tags": [
          "v1-me-api-keys",
          "authentication"
        ],
        "summary": "Create user API key",
        "description": "Creates a new API key for the currently authenticated user",
        "operationId": "create_user_api_key",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateApiKeyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully created API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateApiKeyResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid or missing JWT token"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/v1/me/api-keys/{key_id}": {
      "delete": {
        "tags": [
          "v1-me-api-keys",
          "authentication"
        ],
        "summary": "Revoke user API key",
        "description": "Revokes an API key owned by the currently authenticated user",
        "operationId": "revoke_user_api_key",
        "parameters": [
          {
            "name": "key_id",
            "in": "path",
            "description": "Unique identifier of the API key to revoke",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully revoked API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteApiKeyResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid or missing JWT token"
          },
          "404": {
            "description": "API key not found or not owned by the user"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "UserSessionItem": {
        "type": "object",
        "required": [
          "session_id",
          "application_type",
          "created_at",
          "file_count"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "description": "Unique identifier of the session",
            "example": "a1b2c3d4-e5f6-7890-1234-567890abcdef"
          },
          "application_type": {
            "type": "string",
            "description": "Type of application used for this session",
            "example": "Income Certificate"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the session was created",
            "example": "2025-12-09T10:30:45.123456Z"
          },
          "file_count": {
            "type": "integer",
            "description": "Number of documents associated with this session",
            "example": 2
          }
        }
      },
      "UserSessionListResponse": {
        "type": "object",
        "required": [
          "items",
          "total_count"
        ],
        "properties": {
          "items": {
            "type": "array",
            "description": "List of user sessions",
            "items": {
              "$ref": "#/components/schemas/UserSessionItem"
            }
          },
          "total_count": {
            "type": "integer",
            "description": "Total number of sessions available for the user",
            "example": 15
          }
        }
      },
      "SessionDetailResponse": {
        "type": "object",
        "required": [
          "session_id",
          "application_type",
          "created_at",
          "summary"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "description": "Unique identifier of the session",
            "example": "a1b2c3d4-e5f6-7890-1234-567890abcdef"
          },
          "application_type": {
            "type": "string",
            "description": "Type of application used for this session",
            "example": "Income Certificate"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the session was created",
            "example": "2025-12-09T10:30:45.123456Z"
          },
          "summary": {
            "type": "object",
            "description": "Extracted data from the documents",
            "example": {
              "applicant_name": "John Doe",
              "fathers_name": "Robert Doe",
              "address": "123 Main Street, City, State"
            }
          },
          "bounding_boxes": {
            "type": "object",
            "description": "Mapping of field names to their bounding box coordinates",
            "example": {
              "applicant_name": {
                "filename": "document.pdf",
                "page": 1,
                "coordinates": [
                  120,
                  340,
                  220,
                  560
                ]
              }
            }
          },
          "citations": {
            "type": "object",
            "description": "Mapping of field names to their source citations",
            "example": {
              "applicant_name": "document.pdf (Page 1)"
            }
          },
          "documents": {
            "type": "array",
            "description": "List of documents associated with the session",
            "items": {
              "type": "object",
              "properties": {
                "filename": {
                  "type": "string",
                  "description": "Original filename of the document",
                  "example": "document.pdf"
                },
                "file_path": {
                  "type": "string",
                  "description": "Path to the stored document file",
                  "example": "a1b2c3d4-e5f6-7890-1234-567890abcdef_document.pdf"
                },
                "mime_type": {
                  "type": "string",
                  "description": "MIME type of the document",
                  "example": "application/pdf"
                }
              }
            }
          }
        }
      },
      "ApiKeyItem": {
        "type": "object",
        "required": [
          "id",
          "description",
          "created_at",
          "last_used_at",
          "revoked",
          "total_requests",
          "total_errors",
          "total_documents"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "description": "Unique identifier of the API key",
            "example": 1
          },
          "description": {
            "type": "string",
            "nullable": true,
            "description": "Description of the API key",
            "example": "My production API key"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the API key was created",
            "example": "2025-12-09T10:30:45.123456Z"
          },
          "last_used_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Timestamp when the API key was last used",
            "example": "2025-12-09T12:15:30.246810Z"
          },
          "revoked": {
            "type": "boolean",
            "description": "Whether the API key has been revoked",
            "example": false
          },
          "total_requests": {
            "type": "integer",
            "description": "Total number of requests made with this key",
            "example": 150
          },
          "total_errors": {
            "type": "integer",
            "description": "Total number of errors encountered with this key",
            "example": 2
          },
          "total_documents": {
            "type": "integer",
            "description": "Total number of documents processed with this key",
            "example": 10
          }
        }
      },
      "ApiKeyListResponse": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "description": "List of user's API keys",
            "items": {
              "$ref": "#/components/schemas/ApiKeyItem"
            }
          }
        }
      },
      "CreateApiKeyRequest": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "description": "Description for the new API key",
            "example": "API key for production environment"
          }
        }
      },
      "CreateApiKeyResponse": {
        "type": "object",
        "required": [
          "api_key",
          "id",
          "message"
        ],
        "properties": {
          "api_key": {
            "type": "string",
            "description": "The newly created API key (plaintext)",
            "example": "dv_BxRc8J3fFp9wE2vN6yH1kL5mQ7zT4sA3dG6hJ8nM2p"
          },
          "id": {
            "type": "integer",
            "description": "Unique identifier of the created API key",
            "example": 3
          },
          "message": {
            "type": "string",
            "description": "Status message",
            "example": "API key created"
          }
        }
      },
      "DeleteApiKeyResponse": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string",
            "description": "Success message after revoking API key",
            "example": "API key revoked"
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT authentication token"
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ]
}