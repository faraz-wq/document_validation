{
  "openapi": "3.0.0",
  "info": {
    "title": "Document Validation Service - v1 Me API Keys API",
    "description": "API endpoints for managing user-owned API keys in the Document Validation Service. These endpoints allow authenticated users to create, list, and revoke their own API keys with proper authorization.",
    "version": "1.0.0",
    "contact": {
      "name": "Document Validation Service Support",
      "email": "support@example.com"
    }
  },
  "servers": [
    {
      "url": "/v1",
      "description": "Base URL for v1 API endpoints"
    }
  ],
  "paths": {
    "/me/api-keys/": {
      "get": {
        "summary": "List user API keys",
        "description": "Retrieves a list of API keys owned by the authenticated user. This endpoint requires a valid JWT token in the Authorization header.",
        "operationId": "list_user_api_keys_endpoint",
        "tags": [
          "v1-me-api-keys"
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved list of user API keys",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiKeyListResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid or missing JWT token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      },
      "post": {
        "summary": "Create user API key",
        "description": "Creates a new API key for the authenticated user. The API key is returned in plaintext only once, so it should be stored securely by the client.",
        "operationId": "create_user_api_key",
        "tags": [
          "v1-me-api-keys"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateApiKeyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully created API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateApiKeyResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid or missing JWT token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/me/api-keys/{key_id}": {
      "delete": {
        "summary": "Revoke user API key",
        "description": "Revokes an API key owned by the authenticated user. Once revoked, the API key becomes invalid and cannot be used for authentication.",
        "operationId": "revoke_user_api_key",
        "tags": [
          "v1-me-api-keys"
        ],
        "parameters": [
          {
            "name": "key_id",
            "in": "path",
            "required": true,
            "description": "Unique identifier of the API key to revoke",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully revoked API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteApiKeyResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid or missing JWT token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found - API key does not exist or does not belong to the authenticated user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ApiKeyItem": {
        "type": "object",
        "required": [
          "id",
          "description",
          "created_at",
          "last_used_at",
          "revoked",
          "total_requests",
          "total_errors",
          "total_documents"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "description": "Unique identifier of the API key",
            "example": 1
          },
          "description": {
            "type": "string",
            "nullable": true,
            "description": "User-provided description of the API key",
            "example": "Production API key"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp of when the API key was created",
            "example": "2025-12-09T10:30:45.123456Z"
          },
          "last_used_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "ISO 8601 timestamp of when the API key was last used",
            "example": "2025-12-09T12:15:30.246810Z"
          },
          "revoked": {
            "type": "boolean",
            "description": "Indicates if the API key has been revoked",
            "example": false
          },
          "total_requests": {
            "type": "integer",
            "description": "Total number of requests made using this API key",
            "example": 150
          },
          "total_errors": {
            "type": "integer",
            "description": "Total number of errors encountered using this API key",
            "example": 2
          },
          "total_documents": {
            "type": "integer",
            "description": "Total number of documents processed using this API key",
            "example": 10
          }
        }
      },
      "ApiKeyListResponse": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "description": "Array of API key objects",
            "items": {
              "$ref": "#/components/schemas/ApiKeyItem"
            }
          }
        }
      },
      "CreateApiKeyRequest": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "description": "Optional description for the new API key",
            "default": "",
            "example": "My new production API key"
          }
        }
      },
      "CreateApiKeyResponse": {
        "type": "object",
        "required": [
          "api_key",
          "id",
          "message"
        ],
        "properties": {
          "api_key": {
            "type": "string",
            "description": "The newly created API key in plaintext format",
            "example": "dv_BxRc8J3fFp9wE2vN6yH1kL5mQ7zT4sA3dG6hJ8nM2p"
          },
          "id": {
            "type": "integer",
            "description": "Unique identifier of the created API key",
            "example": 3
          },
          "message": {
            "type": "string",
            "description": "Status message confirming creation",
            "example": "API key created"
          }
        }
      },
      "DeleteApiKeyResponse": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string",
            "description": "Status message confirming revocation",
            "example": "API key revoked"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "detail": {
            "type": "string",
            "description": "Error message providing details about the failure",
            "example": "API key not found or not owned by user"
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT token required for authentication. Include in Authorization header as 'Bearer {token}'."
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ]
}