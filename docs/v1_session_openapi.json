{
  "openapi": "3.0.0",
  "info": {
    "title": "Document Validation Service - v1 Session API",
    "description": "API endpoints for managing user sessions in the Document Validation Service. These endpoints allow authenticated users to access their own sessions with proper ownership verification.",
    "version": "1.0.0",
    "contact": {
      "name": "Document Validation Service Support",
      "email": "support@example.com"
    }
  },
  "servers": [
    {
      "url": "/v1",
      "description": "Base URL for v1 API endpoints"
    }
  ],
  "paths": {
    "/me/sessions": {
      "get": {
        "summary": "List user sessions",
        "description": "Retrieves a paginated list of sessions owned by the authenticated user. This endpoint requires a valid JWT token in the Authorization header.",
        "operationId": "listUserSessions",
        "tags": [
          "v1-user-sessions"
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Number of sessions to return per page. Must be between 1 and 100.",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Number of sessions to skip before starting to collect the result set.",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved list of user sessions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserSessionListResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid or missing JWT token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity - Invalid query parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/me/sessions/{session_id}": {
      "get": {
        "summary": "Get user session details",
        "description": "Retrieves detailed information about a specific session owned by the authenticated user. Only returns sessions that belong to the authenticated user.",
        "operationId": "getUserSession",
        "tags": [
          "v1-user-sessions"
        ],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "description": "Unique identifier of the session to retrieve",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved session details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionDetailResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid or missing JWT token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found - Session does not exist or does not belong to the authenticated user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "UserSessionItem": {
        "type": "object",
        "required": [
          "session_id",
          "application_type",
          "created_at",
          "file_count"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "description": "Unique identifier of the session",
            "example": "a1b2c3d4-e5f6-7890-1234-567890abcdef"
          },
          "application_type": {
            "type": "string",
            "description": "The type of application used for this session",
            "example": "Income Certificate"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp of when the session was created",
            "example": "2025-12-09T10:30:45.123456Z"
          },
          "file_count": {
            "type": "integer",
            "description": "Number of documents associated with this session",
            "example": 2
          }
        }
      },
      "UserSessionListResponse": {
        "type": "object",
        "required": [
          "items",
          "total_count"
        ],
        "properties": {
          "items": {
            "type": "array",
            "description": "Array of session objects",
            "items": {
              "$ref": "#/components/schemas/UserSessionItem"
            }
          },
          "total_count": {
            "type": "integer",
            "description": "Total number of sessions available for the user",
            "example": 15
          }
        }
      },
      "SessionDetailResponse": {
        "type": "object",
        "required": [
          "session_id",
          "application_type",
          "created_at",
          "summary"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "description": "Unique identifier of the session",
            "example": "a1b2c3d4-e5f6-7890-1234-567890abcdef"
          },
          "application_type": {
            "type": "string",
            "description": "The type of application used for this session",
            "example": "Income Certificate"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp of when the session was created",
            "example": "2025-12-09T10:30:45.123456Z"
          },
          "summary": {
            "type": "object",
            "description": "Object containing extracted data from the documents",
            "example": {
              "applicant_name": "John Doe",
              "fathers_name": "Robert Doe",
              "address": "123 Main Street, City, State"
            }
          },
          "bounding_boxes": {
            "type": "object",
            "description": "Object mapping field names to their bounding box coordinates in the documents",
            "example": {
              "applicant_name": {
                "filename": "document.pdf",
                "page": 1,
                "coordinates": [120, 340, 220, 560]
              }
            }
          },
          "citations": {
            "type": "object",
            "description": "Object mapping field names to their source citations",
            "example": {
              "applicant_name": "document.pdf (Page 1)"
            }
          },
          "documents": {
            "type": "array",
            "description": "Array of document objects",
            "items": {
              "type": "object",
              "properties": {
                "filename": {
                  "type": "string",
                  "description": "Original filename of the document",
                  "example": "document.pdf"
                },
                "file_path": {
                  "type": "string",
                  "description": "Path to the stored document file",
                  "example": "a1b2c3d4-e5f6-7890-1234-567890abcdef_document.pdf"
                },
                "mime_type": {
                  "type": "string",
                  "description": "MIME type of the document",
                  "example": "application/pdf"
                }
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "detail": {
            "type": "string",
            "description": "Error message providing details about the failure",
            "example": "Session not found"
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT token required for authentication. Include in Authorization header as 'Bearer {token}'."
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ]
}