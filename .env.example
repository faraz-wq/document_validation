# Gemini API Configuration (Direct API via OpenAI SDK)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-pro

# Vertex AI Configuration (Alternative - use this if your Gemini API key ran out)
# Uncomment these lines to use Vertex AI instead of direct Gemini API
# VERTEX_PROJECT_ID=your-gcp-project-id
# VERTEX_LOCATION=us-central1

# Generation Parameters
TEMPERATURE=0.1
TOP_P=0.95
TOP_K=40
MAX_OUTPUT_TOKENS=8192

# Output Format Configuration (Token Optimization)
# Set to "text" for 20-40% token savings, or "json" for structured output
OUTPUT_FORMAT=text

# File Configuration
MAX_FILE_SIZE_MB=20

# API Retry Configuration
MAX_RETRIES=3
RETRY_DELAY=2.0
RETRY_BACKOFF=2.0

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=document_validation.log
