# --- Backend Configuration ---
GOOGLE_APPLICATION_CREDENTIALS=/app/service-account-credentials.json
GOOGLE_CLOUD_PROJECT=tech-bharath
GOOGLE_GENAI_USE_VERTEXAI=True
TZ=Asia/Kolkata

# Database Configuration (NeonDB - change if using different database)
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@YOUR_HOST/neondb?sslmode=require
DB_USER=neondb_owner
DB_PASSWORD=YOUR_PASSWORD
DB_HOST=YOUR_HOST
DB_PORT=5432
DB_NAME=neondb

# GCS Storage Configuration
GCS_BUCKET_NAME=docv-data
GCS_DOCUMENTS_PREFIX=documents/

# --- Frontend Configuration ---
# Leave empty for relative path /api (recommended for production)
VITE_API_BASE_URL=

# Skip authentication for testing (set to false for production)
SKIP_AUTH=false
