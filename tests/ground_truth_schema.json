{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ground Truth Annotation Schema",
  "description": "Schema for annotating ground truth data for document validation metrics",
  "type": "object",
  "required": ["document_id", "certificate_type", "documents"],
  "properties": {
    "document_id": {
      "type": "string",
      "description": "Unique identifier for this application/test case"
    },
    "certificate_type": {
      "type": "string",
      "enum": ["integrated", "income", "obc", "ews", "family_member"],
      "description": "Type of certificate application"
    },
    "documents": {
      "type": "array",
      "description": "List of documents in this application",
      "items": {
        "type": "object",
        "required": ["file_name", "document_type", "ground_truth_fields"],
        "properties": {
          "file_name": {
            "type": "string",
            "description": "Name of the document file"
          },
          "document_type": {
            "type": "string",
            "description": "Type of document (e.g., 'Application Form', 'Ration Card')"
          },
          "ground_truth_fields": {
            "type": "object",
            "description": "Key-value pairs of field names and their correct values",
            "additionalProperties": {
              "type": "string"
            }
          },
          "quality_level": {
            "type": "string",
            "enum": ["clean", "medium", "challenging"],
            "description": "Quality level of the document for categorization"
          },
          "notes": {
            "type": "string",
            "description": "Any additional notes about this document"
          }
        }
      }
    },
    "expected_summary": {
      "type": "object",
      "description": "Expected values in the Stage 2 summary",
      "additionalProperties": {
        "type": "object",
        "required": ["value", "source_documents"],
        "properties": {
          "value": {
            "type": "string",
            "description": "Expected value for this field"
          },
          "source_documents": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of source document file names"
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata",
      "properties": {
        "annotator": {
          "type": "string",
          "description": "Person who created this annotation"
        },
        "annotation_date": {
          "type": "string",
          "format": "date",
          "description": "Date of annotation"
        },
        "difficulty": {
          "type": "string",
          "enum": ["easy", "medium", "hard"],
          "description": "Overall difficulty level"
        }
      }
    }
  }
}
